rules_version = '2';

// CrewMaster Firestore rules.
// - Reads/writes require an authenticated user whose email is in the
//   authorizedEmails list on the main appData doc, OR who is the hardcoded
//   super admin.
// - Emails are stored and compared in lowercase. The client save flow
//   normalizes both authorizedEmails entries and Employee.linkedUserEmail.
// - Firestore rules do not support .toLowerCase() on string lookups, so the
//   token email is lowercased and matched against the stored list as-is.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'marcoguidopalermo@gmail.com';
    }

    function isAuthorized() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in
          get(/databases/$(database)/documents/artifacts/crewmaster/public/data/appData/main).data.authorizedEmails;
    }

    // All artifacts (public app data + private subcollections) require auth.
    match /artifacts/{document=**} {
      allow read, write: if isAuthorized() || isSuperAdmin();
    }

    // SnowMaster commercial contracts. These are CLIENT-FACING legal
    // documents, so reads are open to authorized users (managers need to see
    // them) while writes are restricted at the app layer by the RoleMaster
    // permission the UI enforces. Kept OUTSIDE artifacts/** deliberately: the
    // artifacts/** rule grants write to every authorized user and its
    // OR-semantics mean it cannot be narrowed.
    match /snowContracts/{contractId} {
      allow read: if isAuthorized() || isSuperAdmin();
      allow write: if isAuthorized() || isSuperAdmin();
    }

    // Snow rate configs — immutable pricing-config versions. Kept OUTSIDE
    // artifacts/** on purpose: the artifacts/** rule grants write to every
    // authorized user and OR-semantics mean it can't be narrowed, so the rate
    // config lives here where WRITES can be locked to the super-admin.
    // Read stays open to authorized users so estimators price at current rates
    // (the numbers are the same ones shown on every quote). The rate-sheet
    // SCREEN and the write path are super-admin only.
    match /snowRateConfigs/{version} {
      allow read: if isAuthorized() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Lawn rate configs — same model as snowRateConfigs. Read open to authorized
    // users so estimators price at current rates; WRITE locked to the super-admin.
    match /lawnRateConfigs/{version} {
      allow read: if isAuthorized() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // HOURS BANK — the ledger of hours owed to employees. APPEND-ONLY, and
    // enforced HERE rather than only in the app: an entry can be created and
    // then never updated and never deleted, by anyone, including the super
    // admin. A mistake is corrected with a reversing entry (see
    // lib/hoursBank), which is itself a create.
    //
    // Kept OUTSIDE artifacts/** deliberately, for the same reason the rate
    // configs are: the artifacts/** rule grants full write to every authorized
    // user and its OR-semantics mean it cannot be narrowed. Under that rule
    // "append-only" would be a UI convention, and a UI convention is not what
    // you want standing between a payroll record and someone's console.
    //
    // WHO may create is enforced at the app layer (admin only — see
    // addHoursBankEntry). Rules cannot cheaply resolve a role, and the choice
    // was a real one: an authorized non-admin who bypassed the UI could append
    // an entry, but they could not alter or hide one, and every entry carries
    // who wrote it. Tamper-evidence beats a lock that cannot be built here.
    //
    // BREAK GLASS: removing a genuinely junk entry (test data) means editing
    // this rule, deleting, and putting it back — deliberately awkward, because
    // deleting from this collection should never be routine.
    // ACCESS-LIST AUDIT — one entry per address added to or removed from
    // authorizedEmails. APPEND-ONLY and enforced here, not just in the app:
    // this is the log of who changed who can get into the system, so an entry
    // must not be editable or deletable by anyone, super admin included.
    //
    // Kept OUTSIDE artifacts/** for the same reason hoursBank is: that rule
    // grants full write to every authorized user and its OR-semantics cannot be
    // narrowed. Under it, "append-only" would be a UI convention.
    //
    // WHO may create is enforced at the app layer (admin only — see
    // saveAuthorizedEmails). An authorized non-admin bypassing the UI could
    // append a spurious entry, but could not alter or remove a real one, and
    // every entry carries who wrote it. Tamper-evidence over a lock that
    // cannot be expressed here.
    //
    // BREAK GLASS: removing a junk entry means editing this rule, deleting, and
    // putting it back — deliberately awkward.
    match /authorizedEmailAudit/{entryId} {
      allow read: if isAuthorized() || isSuperAdmin();
      allow create: if isAuthorized() || isSuperAdmin();
      allow update, delete: if false;
    }

    match /hoursBank/{entryId} {
      allow read: if isAuthorized() || isSuperAdmin();
      allow create: if isAuthorized() || isSuperAdmin();
      allow update, delete: if false;
    }
  }
}
